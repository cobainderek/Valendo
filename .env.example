# Copie para .env (mesmo diretorio do docker-compose) antes de subir a stack.
# docker compose carrega esse arquivo automaticamente.

# === Dev local / corp sim (docker-compose.yml) ===
# Banco
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=valendo

# Backend
JWT_SECRET=troque-isto-em-producao
GEMINI_API_KEY=

# Frontend (build args do Next, embarcados no bundle - alcancaveis pelo browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# === Producao VM (docker-compose.prod.yml) ===
# Os secrets do backend ja vivem em backend/.env na VM.
# Aqui basta sobrescrever as URLs publicas:
# NEXT_PUBLIC_API_URL=https://dyotech.shop/api
# NEXT_PUBLIC_WS_URL=wss://dyotech.shop
