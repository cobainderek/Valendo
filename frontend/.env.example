# URLs publicas (embarcadas no build do Next, precisam ser alcancaveis pelo browser)

# === Dev local / corp sim (docker-compose.yml na raiz) ===
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# === Producao (docker-compose.prod.yml, atras do Nginx em dyotech.shop) ===
# NEXT_PUBLIC_API_URL=https://dyotech.shop/api
# NEXT_PUBLIC_WS_URL=wss://dyotech.shop

# Opcional: origem permitida para dev (next.config.ts)
# ALLOWED_DEV_ORIGIN=http://localhost:3000
