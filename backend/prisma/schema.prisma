// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  tag          String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  globalXp     Int      @default(0) @map("global_xp")
  role         String   @default("user") @db.VarChar(20) // user | admin

  HostedRooms     Room[]          @relation("rooms_host")
  wonRooms        Room[]          @relation("room_winner")
  roomPlayers     RoomPlayer[]
  answers         Answer[]
  weeklyScores    WeeklyScore[]

  friendshipsRequested  Friendship[]         @relation("friendship_requester")
  friendshipsReceived   Friendship[]         @relation("friendship_addressee")
  conversationsCreated  Conversation[]       @relation("conv_creator")
  conversationMembers   ConversationMember[]
  messages              Message[]

  @@map("users")
}

model Room {
  id         BigInt    @id @default(autoincrement())
  code       String    @unique @db.Char(6)
  hostId     BigInt    @map("host_id")
  theme      String?   @db.VarChar(255)
  status     String    @default("waiting") @db.VarChar(20)
  isPrivate  Boolean   @default(false) @map("is_private")
  isSoloMode Boolean   @default(false) @map("is_solo_mode")
  maxPlayers Int       @default(4) @map("max_players")
  questionTime Int     @default(20) @map("question_time")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  winnerId   BigInt?   @map("winner_id")

  host       User         @relation("rooms_host", fields: [hostId], references: [id])
  winner     User?        @relation("room_winner", fields: [winnerId], references: [id])
  duel       Duel?
  players    RoomPlayer[]

  @@map("rooms")
}

model RoomPlayer {
  id       BigInt   @id @default(autoincrement())
  roomId   BigInt   @map("room_id")
  userId   BigInt   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")
  score    Int      @default(0)
  correct  Int      @default(0)
  finished Boolean  @default(false)
  isBot    Boolean  @default(false) @map("is_bot")
  botName  String?  @map("bot_name") @db.VarChar(50)

  room     Room     @relation(fields: [roomId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId, isBot])
  @@map("room_players")
}

model Duel {
  id          BigInt   @id @default(autoincrement())
  roomId      BigInt   @map("room_id") @unique
  createdAt   DateTime @default(now()) @map("created_at")
  totalRounds Int      @map("total_rounds")

  room        Room     @relation(fields: [roomId], references: [id])
  questions   Question[]

  @@map("duels")
}

model Question {
  id            BigInt   @id @default(autoincrement())
  duelId        BigInt   @map("duel_id")
  text          String
  options       Json
  correctAnswer String   @map("correct_answer") @db.VarChar(255)
  explanationAi String?  @map("explanation_ai")

  duel          Duel     @relation(fields: [duelId], references: [id])
  answers       Answer[]

  @@map("questions")
}

model Answer {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  questionId     BigInt   @map("question_id")
  selectedAnswer String   @map("selected_answer") @db.VarChar(255)
  isCorrect      Boolean  @map("is_correct")
  answeredAt     DateTime @default(now()) @map("answered_at")

  user           User     @relation(fields: [userId], references: [id])
  question       Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@map("answers")
}

model WeeklyScore {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  year   Int
  week   Int
  xp     Int    @default(0)

  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, year, week])
  @@index([year, week, xp(sort: Desc)])
  @@map("weekly_scores")
}

// =====================================================================
// Sistema social: amizades + conversas (DM/grupos) + mensagens
// =====================================================================

model Friendship {
  id          BigInt    @id @default(autoincrement())
  requesterId BigInt    @map("requester_id")
  addresseeId BigInt    @map("addressee_id")
  status      String    @default("pending") @db.VarChar(20) // pending | accepted | rejected
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  requester   User      @relation("friendship_requester", fields: [requesterId], references: [id])
  addressee   User      @relation("friendship_addressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model Conversation {
  id          BigInt   @id @default(autoincrement())
  type        String   @default("dm") @db.VarChar(20) // dm | group
  name        String?  @db.VarChar(100)
  createdById BigInt?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy   User?                  @relation("conv_creator", fields: [createdById], references: [id])
  members     ConversationMember[]
  messages    Message[]

  @@map("conversations")
}

model ConversationMember {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  userId         BigInt    @map("user_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")
  role           String    @default("member") @db.VarChar(20) // member | admin

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  authorId       BigInt    @map("author_id")
  text           String
  sentAt         DateTime  @default(now()) @map("sent_at")
  editedAt       DateTime? @map("edited_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id])

  @@index([conversationId, sentAt(sort: Desc)])
  @@map("messages")
}
