# Copie para .env nesta mesma pasta (/backend) antes de subir a stack.
# docker compose carrega este arquivo automaticamente.

# === Banco (usados pelo container postgres E pelo backend pra montar DATABASE_URL) ===
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=valendo

# === Backend ===
JWT_SECRET=troque-isto-em-producao
GEMINI_API_KEY=

# === Apenas para rodar o backend FORA do docker (npm run start:dev) ===
# Dentro do docker compose, DATABASE_URL e montada automaticamente apontando
# pro service "postgres". Use estas linhas apenas se rodar Node nativo no host:
# DATABASE_URL="postgresql://user:password@localhost:5432/valendo?schema=public"
# PORT=3001

# === Apenas para producao (docker-compose.prod.yml) ===
# CORS_ORIGINS=https://dyotech.shop,https://www.dyotech.shop,http://localhost:3000
